{
  "name": "for-wealth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "db:generate": "pnpm --filter @for-wealth/api run db:generate",
    "db:migrate": "pnpm --filter @for-wealth/api run db:migrate",
    "auth:generate": "pnpm --filter @for-wealth/api run auth:generate"
  }
}
