        },
        "recurring_transactions_schedule": {
          "name": "recurring_transactions_schedule",
          "value": "coalesce(case \"recurring_transactions\".\"frequency\"\n        when 'monthly' then \"recurring_transactions\".\"day\" between 1 and 31 and \"recurring_transactions\".\"weekday\" is null and \"recurring_transactions\".\"month\" is null\n        when 'weekly' then \"recurring_transactions\".\"weekday\" between 1 and 7 and \"recurring_transactions\".\"day\" is null and \"recurring_transactions\".\"month\" is null\n        when 'yearly' then \"recurring_transactions\".\"month\" between 1 and 12 and \"recurring_transactions\".\"day\" between 1 and 31 and \"recurring_transactions\".\"weekday\" is null\n      end, false)"
        },
        "recurring_transactions_start_date_from_2000": {
