# Copy to .env (gitignored) and fill in. The API refuses to start if a value
# is missing or invalid.

# The dev database in the Neon dev project. Left blank so the API refuses to
# start until you set one. Use the direct connection string, with pooling off
# (no -pooler in the host), so migrations run over a plain connection. Never
# use the prod project's string here.
#   postgresql://USER:PASSWORD@ep-NAME.REGION.aws.neon.tech/for_wealth?sslmode=verify-full&channel_binding=require
DATABASE_URL=

# Optional: only needed to run the API tests on this machine. CI runs them on
# every push and PR without it. The same connection string, but ending in
# /for_wealth_test (create that database in Neon first). The tests empty its
# tables, so it must never be the dev database; they refuse to run unless the
# name ends in _test.
# TEST_DATABASE_URL=

# At least 32 characters. Left blank so the API refuses to start until you set
# a real one. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The address the browser uses: the Vite dev server, not the API's own port.
# Verification links and the session cookie are built from it, so they go
# through Vite's proxy to the API.
BETTER_AUTH_URL=http://localhost:5173

# Port the API listens on. The web app's Vite proxy reads it from this file.
PORT=3000
