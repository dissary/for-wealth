# Copy to .env (gitignored) and fill in. The API refuses to start if a value
# is missing or invalid.

# The dev database from compose.yaml. Tests ignore this and use for_wealth_test.
DATABASE_URL=postgres://for_wealth:for_wealth@localhost:5432/for_wealth

# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32

# Port the API listens on. The web app's Vite proxy expects 3000.
PORT=3000
